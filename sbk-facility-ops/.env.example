# Copy to .env and fill in.  Never commit .env.

# Your domain (used by Caddy to get a free HTTPS certificate automatically)
DOMAIN=ops.example.com

# First admin login — only used the very first time the app starts with an empty database.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-something-long

# Time zone used for "today", reports and CSV exports
APP_TZ=Asia/Dubai

# How long a login lasts (days)
SESSION_DAYS=14
